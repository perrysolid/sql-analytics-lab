# Copy this file to .env before starting Docker Compose.
# On Linux, set AIRFLOW_UID to your user id with: echo "AIRFLOW_UID=$(id -u)" > .env
AIRFLOW_UID=50000

# Local demo credentials for the Airflow web UI.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Runtime packages needed by dags/app.py inside the Airflow containers.
_PIP_ADDITIONAL_REQUIREMENTS=beautifulsoup4==4.12.3 pandas==2.2.2 requests==2.32.3 apache-airflow-providers-postgres==5.14.0
